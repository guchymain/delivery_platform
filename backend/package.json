{
  "name": "delivery-platform-backend",
  "version": "1.0.0",
  "description": "Delivery Platform REST API built with Node.js, Express, PostgreSQL and Sequelize",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/api.test.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo:all"
  },
  "keywords": [
    "delivery",
    "express",
    "sequelize",
    "postgresql",
    "jwt",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
